# EditorConfig: https://EditorConfig.org
# Applies to all files unless overridden below.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ---------- C / C++ source ----------
[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 100

# ---------- Build files ----------
[Makefile]
indent_style = tab
indent_size = 4

[*.{mk,make}]
indent_style = tab
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.cmake]
indent_style = space
indent_size = 4

# ---------- Markdown ----------
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# ---------- JSON / YAML ----------
[*.{json,yaml,yml}]
indent_size = 2

# ---------- Shell scripts ----------
[*.sh]
indent_style = space
indent_size = 2

# ---------- Git internals ----------
[.git/**]
indent_style = tab
